##### ОБЩИЕ НАСТРОЙКИ #########################################################
Defaults    env_reset
Defaults    secure_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Defaults    umask_override, umask=0077
Defaults    use_pty
Defaults    log_input, log_output
Defaults    iolog_dir="/var/log/sudo-io"
Defaults    logfile="/var/log/sudo.log"
Defaults    shell_noargs                 # запрещает «sudo -i/-s» без команды

##### РОЛИ ####################################################################
User_Alias  SYSADMINS = %sysadmins
User_Alias  SECADMINS = %secadmins
Runas_Alias ROOT      = root

##### АЛИАСЫ КОМАНД ###########################################################
# -- SYSADMINS ---------------------------------------------------------------
Cmnd_Alias SYS_SVC = /usr/bin/systemctl start *, /usr/bin/systemctl stop *, \
                     /usr/bin/systemctl restart *, /usr/bin/systemctl reload *
Cmnd_Alias SYS_PKG = /usr/bin/apt *, /usr/bin/apt-get *, /usr/bin/apt-mark *, \
                     /usr/bin/apt-key *, /usr/bin/dpkg*
Cmnd_Alias SYS_USR = /usr/sbin/useradd, /usr/sbin/usermod, /usr/sbin/userdel
Cmnd_Alias SYS_FS  = /usr/bin/mount, /usr/bin/umount
Cmnd_Alias SYS_PWR = /usr/sbin/reboot, /usr/sbin/poweroff, /usr/sbin/shutdown
Cmnd_Alias SYS_LOG = /usr/bin/journalctl *

# -- SECADMINS ---------------------------------------------------------------
Cmnd_Alias SEC_AUDIT = /usr/sbin/auditctl, /usr/sbin/ausearch, /usr/sbin/aureport
Cmnd_Alias SEC_APPA  = /usr/sbin/aa-*, /usr/sbin/sshd -T, /usr/sbin/sshd -t
Cmnd_Alias SEC_LOG   = /usr/bin/journalctl *, \
                       /usr/bin/cat  /var/log/*, /usr/bin/less /var/log/*, /usr/bin/tail /var/log/*
Cmnd_Alias SEC_NET   = /usr/bin/ps, /usr/bin/ss, /usr/bin/netstat, /usr/sbin/ip route
Cmnd_Alias SEC_VSD   = /usr/sbin/visudo                          # редактирование sudoers

##### ДОП. НАСТРОЙКИ ДЛЯ SECADMINS ###########################################
Defaults:SECADMINS  editor=/usr/bin/nano     # без аргументов!
Defaults:SECADMINS  !env_editor              # запрет менять $EDITOR

##### РАЗРЕШЁННЫЕ ДЕЙСТВИЯ ####################################################
SYSADMINS  ALL = (ROOT) SYS_SVC, SYS_PKG, SYS_USR, SYS_FS, SYS_PWR, SYS_LOG
SECADMINS  ALL = (ROOT) SEC_AUDIT, SEC_APPA, SEC_LOG, SEC_NET, SEC_VSD

##### ЗАПРЕТ ROOT-SHELL ДЛЯ ОБОИХ #############################################
Cmnd_Alias NO_SHELL = /bin/sh, /bin/bash, /bin/dash, /usr/bin/zsh, /usr/bin/fish, \
                       /usr/bin/su, sudoedit
SYSADMINS, SECADMINS ALL = (ROOT) !NO_SHELL

##### ТОЧЕЧНЫЕ ЗАПРЕТЫ ########################################################
# 1) SYSADMINS — нет доступа к shadow, auditctl, AppArmor, прямому чтению логов, visudo
SYSADMINS ALL = (ROOT) !/usr/sbin/auditctl, !/usr/sbin/aa-*, \
                        !/bin/cat /etc/shadow*, !/usr/bin/less /etc/shadow*, !/usr/bin/tail /etc/shadow*, \
                        !/usr/bin/cat /var/log/*, !/usr/bin/less /var/log/*, !/usr/bin/tail /var/log/*, \
                        !/usr/sbin/visudo

# 2) SECADMINS — нет системного администрирования
SECADMINS ALL = (ROOT) !SYS_SVC, !SYS_PKG, !SYS_USR, !SYS_FS, !SYS_PWR

##### УНИВЕРСАЛЬНЫЕ ГРУППЫ ОТКЛЮЧЕНЫ ##########################################
#%sudo   ALL=(ALL:ALL) ALL
#%admin  ALL=(ALL)     ALL
#%wheel  ALL=(ALL:ALL) ALL

##### ПРАВИЛО root ############################################################
root    ALL=(ALL:ALL) ALL
