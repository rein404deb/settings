/var/log/audit/*.log {
    daily           # Ротация раз в сутки
    rotate 7        # Хранить 7 последних архивированных копий
    compress        # Архивировать старые копии с использованием gzip
    missingok       # Игнорировать отсутствие файла
    notifempty      # Не создавать пустой файл, если журнал пуст
    create 640 root secadmins # Создавать новый файл с указанными правами
}
