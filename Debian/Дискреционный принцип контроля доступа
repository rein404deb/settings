sudo groupadd Domain_admins
sudo apt update && sudo apt install -y acl apparmor-utils auditd
sudo nano /etc/fstab
# в опции монтирования к корневому разделу добавляю acl, например получится строчка UUID=1234-5678 / ext4 defaults,acl,errors=remount-ro 0 1

# права на директорию и файл #
sudo mkdir /etc/acl-policy.d
sudo touch /etc/acl-policy.d/policy.conf
sudo chown root:"secadmins" /etc/acl-policy.d 
sudo chown root:"secadmins" /etc/acl-policy.d/policy.conf
sudo chmod 750 /etc/acl-policy.d
sudo chmod 640 /etc/acl-policy.d/policy.conf

# Утилита /usr/local/sbin/acl-policy должна иметь права 750 и принадлежать root:Domain Admins #
sudo touch /usr/local/sbin/acl-policy
sudo chown root:"Domain Admins" /usr/local/sbin/acl-policy
sudo chmod 750 /usr/local/sbin/acl-policy
